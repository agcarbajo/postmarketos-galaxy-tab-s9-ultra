#!/bin/sh
set -eu

export DISPLAY=:0
export XAUTHORITY=/var/run/lightdm/root/:0

# Warm reboots can leave the DDIC answering 00:00:00 and emitting black.
# Force one complete DRM disable/enable after LightDM has brought X up.
for _ in $(seq 1 30); do
	if [ -r "$XAUTHORITY" ] && xrandr --query >/dev/null 2>&1; then
		break
	fi
	sleep 1
done

xrandr --query >/dev/null 2>&1
xrandr --output DSI-1 --off
sleep 3
xrandr --output DSI-1 --mode 2960x1848 --rate 120
