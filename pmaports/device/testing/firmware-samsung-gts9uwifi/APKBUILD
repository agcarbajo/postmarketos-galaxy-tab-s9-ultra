maintainer="SM-X910 postmarketOS port <gts9uwifi@example.com>"
pkgname=firmware-samsung-gts9uwifi
pkgver=1
pkgrel=5
pkgdesc="Stock Qualcomm Kiwi v2 Wi-Fi and Bluetooth firmware for Samsung Galaxy Tab S9 Ultra Wi-Fi"
url="https://www.samsung.com/"
arch="aarch64"
license="proprietary"
options="!check !strip !archcheck !tracedeps"
source="
	official-amss.bin
	m3.bin
	official-board-2.bin
	qrd-board.bin
	regdb.bin
	hmtbtfw20.tlv
	hmtnv20.bin
	hmtnv20.b21
	hmtnv20.b22
	hmtnv20.b38
"

package() {
	local fw="$pkgdir/usr/lib/firmware/ath12k/WCN7850/hw2.0"
	# Official linux-firmware amss: Samsung's downstream amss stalls WLAN
	# start under mainline ath12k (it expects the cnss2-only phy_ucode QMI).
	install -Dm644 "$srcdir/official-amss.bin" "$fw/amss.bin"
	# Canonical linux-firmware M3; Samsung ships no m3 for kiwi.
	install -Dm644 "$srcdir/m3.bin" "$fw/m3.bin"
	# No official X910/board-id 255 entry yet; use the proven QRD ELF fallback.
	install -Dm644 "$srcdir/official-board-2.bin" "$fw/board-2.bin"
	install -Dm644 "$srcdir/qrd-board.bin" "$fw/board.bin"
	install -Dm644 "$srcdir/regdb.bin" "$fw/regdb.bin"

	# WCN7850 Bluetooth over QUP SE14.  The X910 DTS explicitly requests the
	# validated Samsung b21 NVM; retain the other stock variants and generic
	# image for diagnostics and fallback experiments.
	local bt="$pkgdir/usr/lib/firmware/qca"
	install -Dm644 "$srcdir/hmtbtfw20.tlv" "$bt/hmtbtfw20.tlv"
	install -Dm644 "$srcdir/hmtnv20.bin" "$bt/hmtnv20.bin"
	install -Dm644 "$srcdir/hmtnv20.b21" "$bt/hmtnv20.b21"
	install -Dm644 "$srcdir/hmtnv20.b22" "$bt/hmtnv20.b22"
	install -Dm644 "$srcdir/hmtnv20.b38" "$bt/hmtnv20.b38"
}

