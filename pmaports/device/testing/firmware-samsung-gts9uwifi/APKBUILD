maintainer="SM-X910 postmarketOS port <gts9uwifi@example.com>"
pkgname=firmware-samsung-gts9uwifi
pkgver=1
pkgrel=2
pkgdesc="Stock Qualcomm Kiwi v2 firmware for Samsung Galaxy Tab S9 Ultra Wi-Fi"
url="https://www.samsung.com/"
arch="aarch64"
license="proprietary"
options="!check !strip !archcheck !tracedeps"
source="
	amss20.bin
	m3.bin
	bdwlan-payload.bin
	regdb.bin
"

package() {
	local fw="$pkgdir/usr/lib/firmware/ath12k/WCN7850/hw2.0"
	install -Dm644 "$srcdir/amss20.bin" "$fw/amss.bin"
	# Canonical linux-firmware M3; Samsung ships no m3 for kiwi.
	install -Dm644 "$srcdir/m3.bin" "$fw/m3.bin"
	# Raw BDF payload extracted from Samsung's single-PT_LOAD bdwlan.elf.
	install -Dm644 "$srcdir/bdwlan-payload.bin" "$fw/board.bin"
	install -Dm644 "$srcdir/regdb.bin" "$fw/regdb.bin"
}

