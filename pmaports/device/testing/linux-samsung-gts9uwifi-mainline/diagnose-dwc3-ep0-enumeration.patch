From: SM-X910 postmarketOS port <gts9uwifi@example.com>
Subject: [PATCH] usb: dwc3: trace SM-X910 gadget enumeration and ep0

The physical eUSB2 link on the SM-X910 reaches the same PTN3222 status as the
working Samsung kernel, but the host cannot read the device descriptor.  Log
the gadget pull-up state, every DWC3 event, EP0 transitions and decoded SETUP
packets so the retained journal can distinguish missing IRQs from an EP0
response failure.

---
 drivers/usb/dwc3/ep0.c    | 12 ++++++++++++
 drivers/usb/dwc3/gadget.c | 19 +++++++++++++++++++
 2 files changed, 31 insertions(+)

diff --git a/drivers/usb/dwc3/gadget.c b/drivers/usb/dwc3/gadget.c
index 85ebdf301c9e..4b9389e72cab 100644
--- a/drivers/usb/dwc3/gadget.c
+++ b/drivers/usb/dwc3/gadget.c
@@ -2794,6 +2794,13 @@ static int dwc3_gadget_pullup(struct usb_gadget *g, int is_on)
 	int			ret;
 
 	is_on = !!is_on;
+	dev_info(dwc->dev,
+		 "SM-X910 diag pullup request=%d active=%d connected=%d pullups=%d dctl=%08x dsts=%08x devten=%08x evcount=%08x\n",
+		 is_on, pm_runtime_active(dwc->dev), dwc->connected,
+		 dwc->pullups_connected,
+		 dwc3_readl(dwc, DWC3_DCTL), dwc3_readl(dwc, DWC3_DSTS),
+		 dwc3_readl(dwc, DWC3_DEVTEN),
+		 dwc3_readl(dwc, DWC3_GEVNTCOUNT(0)));
 
 	dwc->softconnect = is_on;
 
@@ -2834,6 +2841,12 @@ static int dwc3_gadget_pullup(struct usb_gadget *g, int is_on)
 		ret = dwc3_gadget_soft_connect(dwc);
 
 	pm_runtime_put(dwc->dev);
+	dev_info(dwc->dev,
+		 "SM-X910 diag pullup done ret=%d connected=%d soft=%d pullups=%d dctl=%08x dsts=%08x devten=%08x evcount=%08x\n",
+		 ret, dwc->connected, dwc->softconnect, dwc->pullups_connected,
+		 dwc3_readl(dwc, DWC3_DCTL), dwc3_readl(dwc, DWC3_DSTS),
+		 dwc3_readl(dwc, DWC3_DEVTEN),
+		 dwc3_readl(dwc, DWC3_GEVNTCOUNT(0)));
 
 	return ret;
 }
@@ -4536,6 +4550,12 @@ static void dwc3_process_event_entry(struct dwc3 *dwc,
 {
 	trace_dwc3_event(event->raw, dwc);
 
+	dev_info(dwc->dev,
+		 "SM-X910 diag event raw=%08x devspec=%u type=%u ep=%u epev=%u status=%u param=%u\n",
+		 event->raw, event->type.is_devspec, event->type.type,
+		 event->depevt.endpoint_number, event->depevt.endpoint_event,
+		 event->depevt.status, event->depevt.parameters);
+
 	if (!event->type.is_devspec)
 		dwc3_endpoint_interrupt(dwc, &event->depevt);
 	else if (event->type.type == DWC3_EVENT_TYPE_DEV)
diff --git a/drivers/usb/dwc3/ep0.c b/drivers/usb/dwc3/ep0.c
index 2043bb39f9f8..3a53558d45c0 100644
--- a/drivers/usb/dwc3/ep0.c
+++ b/drivers/usb/dwc3/ep0.c
@@ -833,6 +833,12 @@ static void dwc3_ep0_inspect_setup(struct dwc3 *dwc,
 	if (!dwc->gadget_driver || !dwc->softconnect || !dwc->connected)
 		goto out;
 
+	dev_info(dwc->dev,
+		 "SM-X910 diag setup type=%02x request=%02x value=%04x index=%04x length=%u state=%u\n",
+		 ctrl->bRequestType, ctrl->bRequest,
+		 le16_to_cpu(ctrl->wValue), le16_to_cpu(ctrl->wIndex),
+		 le16_to_cpu(ctrl->wLength), dwc->ep0state);
+
 	trace_dwc3_ctrl_req(dwc, ctrl);
 
 	len = le16_to_cpu(ctrl->wLength);
@@ -1206,6 +1212,12 @@ void dwc3_ep0_interrupt(struct dwc3 *dwc,
 	struct dwc3_ep	*dep = dwc->eps[event->endpoint_number];
 	u8		cmd;
 
+	dev_info(dwc->dev,
+		 "SM-X910 diag ep0 ep=%u event=%u status=%u param=%u state=%u next=%u connected=%d soft=%d\n",
+		 event->endpoint_number, event->endpoint_event, event->status,
+		 event->parameters, dwc->ep0state, dwc->ep0_next_event,
+		 dwc->connected, dwc->softconnect);
+
 	switch (event->endpoint_event) {
 	case DWC3_DEPEVT_XFERCOMPLETE:
 		dwc3_ep0_xfer_complete(dwc, event);
-- 
2.50.1
