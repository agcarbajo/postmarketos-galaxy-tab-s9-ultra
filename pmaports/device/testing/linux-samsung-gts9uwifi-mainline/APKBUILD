maintainer="SM-X910 postmarketOS port <gts9uwifi@example.com>"
_flavor="samsung-gts9uwifi-mainline"
pkgname=linux-$_flavor
pkgver=7.2_rc3
pkgrel=1
pkgdesc="Mainline kernel for Samsung Galaxy Tab S9 Ultra Wi-Fi"
arch="aarch64"
_carch="arm64"
url="https://kernel.org"
license="GPL-2.0-only"
options="
	!check
	!strip
	!tracedeps
	pmb:cross-native
"
makedepends="
	bash
	bison
	clang
	diffutils
	elfutils-dev
	findutils
	flex
	kmod
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	sed
	zstd
"

_kernelver="${pkgver/_/-}"
_pmaports_commit="b7681d0e857d395edfaa6c8e5cd0d89e4315fd3f"

source="
	linux-$_kernelver.tar.gz::https://git.kernel.org/torvalds/t/linux-$_kernelver.tar.gz
	config-mainline.aarch64::https://gitlab.postmarketos.org/postmarketOS/pmaports/-/raw/$_pmaports_commit/device/main/linux-postmarketos-mainline/config-mainline.aarch64
	add-gts9uwifi-dtb.patch
	config-gts9uwifi.fragment
	sm8550-samsung-gts9uwifi.dts
"
builddir="$srcdir/linux-$_kernelver"

prepare() {
	default_prepare

	cp "$srcdir/sm8550-samsung-gts9uwifi.dts" \
		arch/arm64/boot/dts/qcom/
	cp "$srcdir/config-mainline.aarch64" .config

	unset LDFLAGS
	scripts/kconfig/merge_config.sh -m \
		.config "$srcdir/config-gts9uwifi.fragment"
	make ARCH="$_carch" LLVM=1 olddefconfig
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-$_flavor"
}

package() {
	make modules_install zinstall dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs

	rm -f "$pkgdir"/usr/lib/modules/*/build
	rm -f "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/"$_flavor"/kernel.release
}

