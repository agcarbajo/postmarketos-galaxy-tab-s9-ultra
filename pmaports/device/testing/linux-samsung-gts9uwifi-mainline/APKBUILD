maintainer="SM-X910 postmarketOS port <gts9uwifi@example.com>"
_flavor="samsung-gts9uwifi-mainline"
pkgname=linux-$_flavor
pkgver=7.2_rc3
pkgrel=97
pkgdesc="Mainline kernel for Samsung Galaxy Tab S9 Ultra Wi-Fi"
arch="aarch64"
_carch="arm64"
url="https://kernel.org"
license="GPL-2.0-only"
options="
	!check
	!strip
	!tracedeps
	pmb:cross-native
"
makedepends="
	bash
	bison
	clang
	diffutils
	elfutils-dev
	findutils
	flex
	kmod
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	sed
	zstd
"

_kernelver="${pkgver/_/-}"
_pmaports_commit="b7681d0e857d395edfaa6c8e5cd0d89e4315fd3f"

source="
	linux-$_kernelver.tar.gz::https://git.kernel.org/torvalds/t/linux-$_kernelver.tar.gz
	config-mainline.aarch64::https://gitlab.postmarketos.org/postmarketOS/pmaports/-/raw/$_pmaports_commit/device/main/linux-postmarketos-mainline/config-mainline.aarch64
	add-gts9uwifi-dtb.patch
	add-samsung-sec-log-console.patch
	keep-sec-log-previous-index-current.patch
	match-samsung-sm8550-eusb2-phy-init.patch
	support-samsung-goodix-16-byte-events.patch
	configure-nxp-ptn3222-from-dt.patch
	wcn7850-pwrseq-cold-reset-aop.patch
	build-wcn-pcie-providers-in.patch
	unpark-pcie0-pipe-mux.patch
	expose-separate-gpu-kms-resources.patch
	ignore-console-null.patch
	msm-dp-allow-unresolved-usbc-bridge.patch
	tcpm-adopt-retained-source-ufp-role.patch
	config-gts9uwifi.fragment
	sm8550-samsung-gts9uwifi.dts
	panel-samsung-ana38407.c
	sm5440_direct.c
	sm5714_battery.c
	sm5714_usbpd.c
	ps5169.c
"
builddir="$srcdir/linux-$_kernelver"

prepare() {
	default_prepare

	cp "$srcdir/sm8550-samsung-gts9uwifi.dts" \
		arch/arm64/boot/dts/qcom/

	# ANA38407 (gts9u) DSI panel driver: drop the source in and register it.
	cp "$srcdir/panel-samsung-ana38407.c" drivers/gpu/drm/panel/
	if ! grep -q 'DRM_PANEL_SAMSUNG_ANA38407' drivers/gpu/drm/panel/Kconfig; then
		sed -i '/^endmenu$/i \
config DRM_PANEL_SAMSUNG_ANA38407\
\ttristate "Samsung ANA38407 AMSA46AS02 (gts9u) DSI command-mode panel"\
\tdepends on OF\
\tdepends on DRM_MIPI_DSI\
\tdepends on BACKLIGHT_CLASS_DEVICE\
' drivers/gpu/drm/panel/Kconfig
	fi
	grep -q 'panel-samsung-ana38407.o' drivers/gpu/drm/panel/Makefile || \
		echo 'obj-$(CONFIG_DRM_PANEL_SAMSUNG_ANA38407) += panel-samsung-ana38407.o' \
			>> drivers/gpu/drm/panel/Makefile

	# Silicon Mitus SM5714 charger / fuel gauge: same treatment as the panel.
	cp "$srcdir/sm5714_battery.c" drivers/power/supply/
	if ! grep -q 'BATTERY_SM5714' drivers/power/supply/Kconfig; then
		sed -i '/^endif # POWER_SUPPLY$/i \
config BATTERY_SM5714\
\ttristate "Silicon Mitus SM5714 charger and fuel gauge"\
\tdepends on I2C\
\tdepends on IIO\
' drivers/power/supply/Kconfig
	fi
	grep -q 'sm5714_battery.o' drivers/power/supply/Makefile || \
		echo 'obj-$(CONFIG_BATTERY_SM5714)	+= sm5714_battery.o' \
			>> drivers/power/supply/Makefile

	# SM5440 2:1 direct charger; USB-PD/PPS policy stays in Linux TCPM.
	cp "$srcdir/sm5440_direct.c" drivers/power/supply/
	if ! grep -q 'CHARGER_SM5440_DIRECT' drivers/power/supply/Kconfig; then
		sed -i '/^endif # POWER_SUPPLY$/i \
config CHARGER_SM5440_DIRECT\
\ttristate "Silicon Mitus SM5440 direct charger for Samsung SM-X910"\
\tdepends on I2C\
\tdepends on BATTERY_SM5714\
' drivers/power/supply/Kconfig
	fi
	grep -q 'sm5440_direct.o' drivers/power/supply/Makefile || \
		echo 'obj-$(CONFIG_CHARGER_SM5440_DIRECT)	+= sm5440_direct.o' \
			>> drivers/power/supply/Makefile

	# SM5714 Type-C/PD transport; policy stays in the upstream TCPM core.
	cp "$srcdir/sm5714_usbpd.c" drivers/usb/typec/tcpm/
	if ! grep -q 'TYPEC_SM5714' drivers/usb/typec/tcpm/Kconfig; then
		sed -i '/^endif # TYPEC_TCPM$/i \
config TYPEC_SM5714\
\ttristate "Silicon Mitus SM5714 USB Type-C and PD controller"\
\tdepends on I2C\
\tdepends on TYPEC_TCPM\
\tdepends on BATTERY_SM5714\
' drivers/usb/typec/tcpm/Kconfig
	fi
	grep -q 'sm5714_usbpd.o' drivers/usb/typec/tcpm/Makefile || \
		echo 'obj-$(CONFIG_TYPEC_SM5714)	+= sm5714_usbpd.o' \
			>> drivers/usb/typec/tcpm/Makefile

	# Parade PS5169 SuperSpeed/DisplayPort redriver on the X910.
	cp "$srcdir/ps5169.c" drivers/usb/typec/mux/
	if ! grep -q 'TYPEC_MUX_PS5169' drivers/usb/typec/mux/Kconfig; then
		cat >> drivers/usb/typec/mux/Kconfig <<-'EOF'

	config TYPEC_MUX_PS5169
		tristate "Parade PS5169 Type-C redriver"
		depends on I2C
		depends on TYPEC
		depends on USB_ROLE_SWITCH
	EOF
	fi
	grep -q 'ps5169.o' drivers/usb/typec/mux/Makefile || \
		echo 'obj-$(CONFIG_TYPEC_MUX_PS5169)	+= ps5169.o' \
			>> drivers/usb/typec/mux/Makefile

	cp "$srcdir/config-mainline.aarch64" .config

	unset LDFLAGS
	scripts/kconfig/merge_config.sh -m \
		.config "$srcdir/config-gts9uwifi.fragment"
	make ARCH="$_carch" LLVM=1 olddefconfig
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-$_flavor"
}

package() {
	make modules_install zinstall dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs

	rm -f "$pkgdir"/usr/lib/modules/*/build
	rm -f "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/"$_flavor"/kernel.release
}

