From: SM-X910 postmarketOS port <gts9uwifi@example.com>
Subject: [PATCH] usb: dwc3: remove timing-sensitive hot-path diagnostics

The temporary SM-X910 enumeration trace logs every DWC3 event twice around
EP0 and every decoded SETUP packet at info level.  The retained v0.31 journal
shows 20-21 ms gaps between these synchronous messages while Windows retries
the same descriptors and eventually reports Code 43.  Keep the two one-shot
pull-up state messages, but remove all printk calls from the IRQ/EP0 hot path.
The existing DWC3 tracepoints remain available for targeted tracing.

---
 drivers/usb/dwc3/ep0.c    | 12 ------------
 drivers/usb/dwc3/gadget.c |  6 ------
 2 files changed, 18 deletions(-)

diff --git a/drivers/usb/dwc3/gadget.c b/drivers/usb/dwc3/gadget.c
--- a/drivers/usb/dwc3/gadget.c
+++ b/drivers/usb/dwc3/gadget.c
@@ -4550,12 +4550,6 @@ static void dwc3_process_event_entry(struct dwc3 *dwc,
 {
 	trace_dwc3_event(event->raw, dwc);
 
-	dev_info(dwc->dev,
-		 "SM-X910 diag event raw=%08x devspec=%u type=%u ep=%u epev=%u status=%u param=%u\n",
-		 event->raw, event->type.is_devspec, event->type.type,
-		 event->depevt.endpoint_number, event->depevt.endpoint_event,
-		 event->depevt.status, event->depevt.parameters);
-
 	if (!event->type.is_devspec)
 		dwc3_endpoint_interrupt(dwc, &event->depevt);
 	else if (event->type.type == DWC3_EVENT_TYPE_DEV)
diff --git a/drivers/usb/dwc3/ep0.c b/drivers/usb/dwc3/ep0.c
--- a/drivers/usb/dwc3/ep0.c
+++ b/drivers/usb/dwc3/ep0.c
@@ -833,12 +833,6 @@ static void dwc3_ep0_inspect_setup(struct dwc3 *dwc,
 	if (!dwc->gadget_driver || !dwc->softconnect || !dwc->connected)
 		goto out;
 
-	dev_info(dwc->dev,
-		 "SM-X910 diag setup type=%02x request=%02x value=%04x index=%04x length=%u state=%u\n",
-		 ctrl->bRequestType, ctrl->bRequest,
-		 le16_to_cpu(ctrl->wValue), le16_to_cpu(ctrl->wIndex),
-		 le16_to_cpu(ctrl->wLength), dwc->ep0state);
-
 	trace_dwc3_ctrl_req(dwc, ctrl);
 
 	len = le16_to_cpu(ctrl->wLength);
@@ -1212,12 +1206,6 @@ void dwc3_ep0_interrupt(struct dwc3 *dwc,
 	struct dwc3_ep	*dep = dwc->eps[event->endpoint_number];
 	u8		cmd;
 
-	dev_info(dwc->dev,
-		 "SM-X910 diag ep0 ep=%u event=%u status=%u param=%u state=%u next=%u connected=%d soft=%d\n",
-		 event->endpoint_number, event->endpoint_event, event->status,
-		 event->parameters, dwc->ep0state, dwc->ep0_next_event,
-		 dwc->connected, dwc->softconnect);
-
 	switch (event->endpoint_event) {
 	case DWC3_DEPEVT_XFERCOMPLETE:
 		dwc3_ep0_xfer_complete(dwc, event);
-- 
2.50.1
