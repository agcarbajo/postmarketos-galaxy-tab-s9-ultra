From: SM-X910 postmarketOS port <gts9uwifi@example.com>
Subject: [PATCH] input: goodix: support 16-byte Samsung Berlin events

Samsung's GT6936 firmware reports the point structure length as 16 bytes in
IC_INFO.  The upstream Berlin driver parses that field but then assumes the
8-byte reference format unconditionally.  This makes it mistake bytes 8 and
9 of each Samsung event for the checksum and discard every touch.

Use the runtime header/point lengths from IC_INFO, retain the existing 8-byte
format, and decode the 16-byte coordinate layout used by the Samsung driver.

---
 drivers/input/touchscreen/goodix_berlin_core.c | 91 +++++++++++++++++++++-----
 1 file changed, 76 insertions(+), 15 deletions(-)

diff --git a/drivers/input/touchscreen/goodix_berlin_core.c b/drivers/input/touchscreen/goodix_berlin_core.c
index 9aa4bf80d7b8..e8e43e4d405b 100644
--- a/drivers/input/touchscreen/goodix_berlin_core.c
+++ b/drivers/input/touchscreen/goodix_berlin_core.c
@@ -30,6 +30,7 @@
 #include "goodix_berlin.h"
 
 #define GOODIX_BERLIN_MAX_TOUCH			10
+#define GOODIX_BERLIN_MAX_POINT_SIZE		16
 
 #define GOODIX_BERLIN_NORMAL_RESET_DELAY_MS	100
 
@@ -45,6 +46,12 @@
 
 #define GOODIX_BERLIN_TOUCH_ID_MASK		GENMASK(7, 4)
 
+#define GOODIX_BERLIN_SAMSUNG_EVENT_ID_MASK	GENMASK(1, 0)
+#define GOODIX_BERLIN_SAMSUNG_TOUCH_ID_MASK	GENMASK(5, 2)
+#define GOODIX_BERLIN_SAMSUNG_ACTION_MASK	GENMASK(7, 6)
+#define GOODIX_BERLIN_SAMSUNG_COORD_EVENT	0
+#define GOODIX_BERLIN_SAMSUNG_ACTION_RELEASE	3
+
 #define GOODIX_BERLIN_DEV_CONFIRM_VAL		0xAA
 #define GOODIX_BERLIN_BOOTOPTION_ADDR		0x10000
 
@@ -154,7 +161,7 @@ struct goodix_berlin_header {
 struct goodix_berlin_event {
 	struct goodix_berlin_header hdr;
 	/* The data below is u16/__le16 aligned */
-	u8 data[GOODIX_BERLIN_TOUCH_SIZE * GOODIX_BERLIN_MAX_TOUCH +
+	u8 data[GOODIX_BERLIN_MAX_POINT_SIZE * GOODIX_BERLIN_MAX_TOUCH +
 		GOODIX_BERLIN_CHECKSUM_SIZE];
 };
 
@@ -173,6 +180,8 @@ struct goodix_berlin_core {
 
 	/* Runtime parameters extracted from IC_INFO buffer  */
 	u32 touch_data_addr;
+	u16 touch_data_head_len;
+	u16 point_struct_len;
 
 	const struct goodix_berlin_ic_data *ic_data;
 
@@ -348,7 +357,18 @@ static int goodix_berlin_parse_ic_info(struct goodix_berlin_core *cd,
 #undef ADVANCE_LE16_PARAMS
 
 	misc = (struct goodix_berlin_ic_info_misc *)&data[offset];
+	if (offset + sizeof(*misc) > length)
+		goto invalid_offset;
+
 	cd->touch_data_addr = le32_to_cpu(misc->touch_data_addr);
+	cd->touch_data_head_len = le16_to_cpu(misc->touch_data_head_len);
+	cd->point_struct_len = le16_to_cpu(misc->point_struct_len);
+	if (cd->touch_data_head_len != GOODIX_BERLIN_HEADER_SIZE ||
+	    (cd->point_struct_len != GOODIX_BERLIN_TOUCH_SIZE &&
+	     cd->point_struct_len != GOODIX_BERLIN_MAX_POINT_SIZE))
+		return dev_err_probe(cd->dev, -EINVAL,
+			"unsupported event layout: header %u point %u\n",
+			cd->touch_data_head_len, cd->point_struct_len);
 
 	return 0;
 
@@ -416,14 +434,14 @@ static int goodix_berlin_get_remaining_contacts(struct goodix_berlin_core *cd,
 static int goodix_berlin_get_remaining_contacts(struct goodix_berlin_core *cd,
 						int n)
 {
-	size_t offset = 2 * GOODIX_BERLIN_TOUCH_SIZE +
+	size_t offset = 2 * cd->point_struct_len +
 				GOODIX_BERLIN_CHECKSUM_SIZE;
-	u32 addr = cd->touch_data_addr + GOODIX_BERLIN_HEADER_SIZE + offset;
+	u32 addr = cd->touch_data_addr + cd->touch_data_head_len + offset;
 	int error;
 
 	error = regmap_raw_read(cd->regmap, addr,
 				&cd->event.data[offset],
-				(n - 2) * GOODIX_BERLIN_TOUCH_SIZE);
+				(n - 2) * cd->point_struct_len);
 	if (error) {
 		dev_err_ratelimited(cd->dev, "failed to get touch data, %d\n",
 				    error);
@@ -434,16 +454,50 @@ static int goodix_berlin_get_remaining_contacts(struct goodix_berlin_core *cd,
 	return 0;
 }
 
+static void goodix_berlin_report_samsung_touch(struct goodix_berlin_core *cd,
+					       const u8 *data, bool *coordinate)
+{
+	u8 action, id;
+	u16 x, y;
+
+	if (FIELD_GET(GOODIX_BERLIN_SAMSUNG_EVENT_ID_MASK, data[0]) !=
+	    GOODIX_BERLIN_SAMSUNG_COORD_EVENT)
+		return;
+
+	*coordinate = true;
+	id = FIELD_GET(GOODIX_BERLIN_SAMSUNG_TOUCH_ID_MASK, data[0]);
+	if (id >= GOODIX_BERLIN_MAX_TOUCH)
+		return;
+
+	action = FIELD_GET(GOODIX_BERLIN_SAMSUNG_ACTION_MASK, data[0]);
+	input_mt_slot(cd->input_dev, id);
+	input_mt_report_slot_state(cd->input_dev, MT_TOOL_FINGER,
+				   action != GOODIX_BERLIN_SAMSUNG_ACTION_RELEASE);
+	if (action == GOODIX_BERLIN_SAMSUNG_ACTION_RELEASE)
+		return;
+
+	x = data[1] << 4 | data[3] >> 4;
+	y = data[2] << 4 | (data[3] & 0x0f);
+	touchscreen_report_pos(cd->input_dev, &cd->props, x, y, true);
+	input_report_abs(cd->input_dev, ABS_MT_TOUCH_MAJOR, data[4]);
+}
+
 static void goodix_berlin_report_state(struct goodix_berlin_core *cd, int n)
 {
-	struct goodix_berlin_touch *touch_data =
-			(struct goodix_berlin_touch *)cd->event.data;
 	struct goodix_berlin_touch *t;
+	const u8 *data = cd->event.data;
+	bool coordinate = !n || cd->point_struct_len == GOODIX_BERLIN_TOUCH_SIZE;
 	int i;
 	u8 type, id;
 
 	for (i = 0; i < n; i++) {
-		t = &touch_data[i];
+		if (cd->point_struct_len == GOODIX_BERLIN_MAX_POINT_SIZE) {
+			goodix_berlin_report_samsung_touch(cd, data, &coordinate);
+			data += cd->point_struct_len;
+			continue;
+		}
+
+		t = (struct goodix_berlin_touch *)data;
 
 		type = FIELD_GET(GOODIX_BERLIN_POINT_TYPE_MASK, t->status);
 		if (type == GOODIX_BERLIN_POINT_TYPE_STYLUS ||
@@ -466,7 +520,12 @@ static void goodix_berlin_report_state(struct goodix_berlin_core *cd, int n)
 		input_report_abs(cd->input_dev, ABS_MT_TOUCH_MAJOR,
 				 __le16_to_cpu(t->w));
+
+		data += cd->point_struct_len;
 	}
 
+	if (!coordinate)
+		return;
+
 	input_mt_sync_frame(cd->input_dev);
 	input_sync(cd->input_dev);
 }
@@ -491,7 +550,7 @@ static void goodix_berlin_touch_handler(struct goodix_berlin_core *cd)
 	}
 
 	if (touch_num) {
-		int len = touch_num * GOODIX_BERLIN_TOUCH_SIZE +
+		int len = touch_num * cd->point_struct_len +
 			  GOODIX_BERLIN_CHECKSUM_SIZE;
 		if (!goodix_berlin_checksum_valid(cd->event.data, len)) {
 			dev_err(cd->dev, "touch data checksum error: %*ph\n",
@@ -521,9 +580,9 @@ static irqreturn_t goodix_berlin_irq(int irq, void *data)
 	/*
 	 * First, read buffer with space for 2 touch events:
 	 * - GOODIX_BERLIN_HEADER_SIZE = 8 bytes
-	 * - GOODIX_BERLIN_TOUCH_SIZE * 2 = 16 bytes
+	 * - point_struct_len * 2 = 16 or 32 bytes
 	 * - GOODIX_BERLIN_CHECKLSUM_SIZE = 2 bytes
-	 * For a total of 26 bytes.
+	 * For a total of 26 or 42 bytes.
 	 *
 	 * If only a single finger is reported, we will read 8 bytes more than
 	 * needed:
@@ -556,9 +615,9 @@ static irqreturn_t goodix_berlin_irq(int irq, void *data)
 	 */
 	error = regmap_raw_read(cd->regmap, cd->touch_data_addr,
 				&cd->event,
-				GOODIX_BERLIN_HEADER_SIZE +
-					2 * GOODIX_BERLIN_TOUCH_SIZE +
-					GOODIX_BERLIN_CHECKSUM_SIZE);
+				cd->touch_data_head_len +
+					2 * cd->point_struct_len +
+					GOODIX_BERLIN_CHECKSUM_SIZE);
 	if (error) {
 		dev_warn_ratelimited(cd->dev,
 				     "failed get event head data: %d\n", error);
@@ -797,8 +856,10 @@ int goodix_berlin_probe(struct device *dev, int irq, const struct input_id *id,
 
 	dev_set_drvdata(dev, cd);
 
-	dev_dbg(dev, "Goodix Berlin %s Touchscreen Controller",
-		cd->fw_version.patch_pid);
+	dev_info(dev,
+		 "Goodix Berlin %s Touchscreen Controller, event layout %u/%u\n",
+		 cd->fw_version.patch_pid, cd->touch_data_head_len,
+		 cd->point_struct_len);
 
 	return 0;
 }
-- 
2.50.1
