--- a/drivers/power/sequencing/pwrseq-qcom-wcn.c	2026-07-20 19:11:17.100214622 +0200
+++ b/drivers/power/sequencing/pwrseq-qcom-wcn.c	2026-07-20 19:11:17.100214622 +0200
@@ -38,6 +38,8 @@
 	struct gpio_desc *bt_gpio;
 	struct gpio_desc *wlan_gpio;
 	struct gpio_desc *xo_clk_gpio;
+	struct gpio_desc *wlan_sw_ctrl_gpio;
+	struct gpio_desc *bt_sw_ctrl_gpio;
 	struct clk *clk;
 	unsigned long last_gpio_enable_jf;
 };
@@ -225,6 +227,30 @@
 	pr_info("SM-X910 WCN diag: WLAN_EN after=%d\n",
 		gpiod_get_value_cansleep(ctx->wlan_gpio));
 
+	/*
+	 * The WCN7850 reports its internal PMU state on the SW_CTRL pins
+	 * (GPIO83 WLAN, GPIO82 BT on the X910).  Stock cnss2 samples them as
+	 * inputs.  Log them over the first 600 ms after WLAN_EN so the journal
+	 * shows whether the on-module power sequencer ever finishes; the extra
+	 * sleeps also delay PERST deassert, covering the slow-start case.
+	 */
+	if (ctx->wlan_sw_ctrl_gpio || ctx->bt_sw_ctrl_gpio) {
+		static const unsigned int delays_ms[] = { 0, 100, 300, 600 };
+		unsigned int i;
+
+		for (i = 0; i < ARRAY_SIZE(delays_ms); i++) {
+			if (delays_ms[i])
+				msleep(delays_ms[i] -
+				       (i > 0 ? delays_ms[i - 1] : 0));
+			pr_info("SM-X910 WCN diag: t+%ums SW_CTRL wlan=%d bt=%d\n",
+				delays_ms[i],
+				ctx->wlan_sw_ctrl_gpio ?
+				gpiod_get_value_cansleep(ctx->wlan_sw_ctrl_gpio) : -1,
+				ctx->bt_sw_ctrl_gpio ?
+				gpiod_get_value_cansleep(ctx->bt_sw_ctrl_gpio) : -1);
+		}
+	}
+
 	return 0;
 }
 
@@ -575,6 +601,18 @@
 		return dev_err_probe(dev, PTR_ERR(ctx->xo_clk_gpio),
 				     "Failed to get the XO_CLK GPIO\n");
 
+	ctx->wlan_sw_ctrl_gpio = devm_gpiod_get_optional(dev, "wlan-sw-ctrl",
+							 GPIOD_IN);
+	if (IS_ERR(ctx->wlan_sw_ctrl_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->wlan_sw_ctrl_gpio),
+				     "Failed to get the WLAN SW_CTRL GPIO\n");
+
+	ctx->bt_sw_ctrl_gpio = devm_gpiod_get_optional(dev, "bt-sw-ctrl",
+						       GPIOD_IN);
+	if (IS_ERR(ctx->bt_sw_ctrl_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->bt_sw_ctrl_gpio),
+				     "Failed to get the BT SW_CTRL GPIO\n");
+
 	/*
 	 * Set direction to output but keep the current value in order to not
 	 * disable the WLAN module accidentally if it's already powered on.
