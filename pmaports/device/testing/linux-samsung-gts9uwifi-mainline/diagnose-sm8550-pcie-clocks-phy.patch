+static u32 sm_x910_diag_readl(phys_addr_t addr)
+{
+	void __iomem *base;
+	u32 val = U32_MAX;
+
+	base = ioremap(addr, sizeof(val));
+	if (base) {
+		val = readl(base);
+		iounmap(base);
+	}
+
+	return val;
+}
+
+static void sm_x910_dump_pcie_signals(struct qcom_pcie *pcie)
+{
+	struct qcom_pcie_resources_2_7_0 *res = &pcie->res.v2_7_0;
+	struct device *dev = pcie->pci->dev;
+	int i;
+
+	if (!of_device_is_compatible(dev->of_node, "qcom,pcie-sm8550"))
+		return;
+
+	for (i = 0; i < res->num_clks; i++) {
+		if (!res->clks[i].clk)
+			continue;
+
+		dev_info(dev,
+			 "SM-X910 PCIe diag: clock %s enabled=%d rate=%lu\n",
+			 res->clks[i].id, __clk_is_enabled(res->clks[i].clk),
+			 clk_get_rate(res->clks[i].clk));
+	}
+
+	dev_info(dev,
+		 "SM-X910 PCIe diag: TLMM wlan80=%#x/%#x bt81=%#x/%#x sw82=%#x/%#x sw83=%#x/%#x\n",
+		 sm_x910_diag_readl(0x0f050000), sm_x910_diag_readl(0x0f050004),
+		 sm_x910_diag_readl(0x0f051000), sm_x910_diag_readl(0x0f051004),
+		 sm_x910_diag_readl(0x0f052000), sm_x910_diag_readl(0x0f052004),
+		 sm_x910_diag_readl(0x0f053000), sm_x910_diag_readl(0x0f053004));
+	dev_info(dev,
+		 "SM-X910 PCIe diag: TLMM perst94=%#x/%#x clkreq95=%#x/%#x wake96=%#x/%#x TCSR_CLKREF=%#x\n",
+		 sm_x910_diag_readl(0x0f05e000), sm_x910_diag_readl(0x0f05e004),
+		 sm_x910_diag_readl(0x0f05f000), sm_x910_diag_readl(0x0f05f004),
+		 sm_x910_diag_readl(0x0f060000), sm_x910_diag_readl(0x0f060004),
+		 sm_x910_diag_readl(0x01fd5100));
+	dev_info(dev,
+		 "SM-X910 PCIe diag: PARF SYS=%#x PHY=%#x REFCLK=%#x LTSSM=%#x\n",
+		 readl(pcie->parf + PARF_SYS_CTRL),
+		 readl(pcie->parf + PARF_PHY_CTRL),
+		 readl(pcie->parf + PARF_PHY_REFCLK),
+		 readl(pcie->parf + PARF_LTSSM));
+}
