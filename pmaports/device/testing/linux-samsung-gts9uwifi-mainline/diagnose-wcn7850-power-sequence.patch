diff --git a/drivers/power/sequencing/pwrseq-qcom-wcn.c b/drivers/power/sequencing/pwrseq-qcom-wcn.c
index 3d57324ff134..d647099e14f5 100644
--- a/drivers/power/sequencing/pwrseq-qcom-wcn.c
+++ b/drivers/power/sequencing/pwrseq-qcom-wcn.c
@@ -67,8 +67,14 @@ static const struct pwrseq_unit_data pwrseq_qcom_wcn_vddio_unit_data = {
 static int pwrseq_qcom_wcn_vregs_enable(struct pwrseq_device *pwrseq)
 {
 	struct pwrseq_qcom_wcn_ctx *ctx = pwrseq_device_get_drvdata(pwrseq);
+	int ret;
 
-	return regulator_bulk_enable(ctx->pdata->num_vregs, ctx->regs);
+	pr_info("SM-X910 WCN diag: enabling %zu PMU input regulators\n",
+		ctx->pdata->num_vregs);
+	ret = regulator_bulk_enable(ctx->pdata->num_vregs, ctx->regs);
+	pr_info("SM-X910 WCN diag: PMU input regulators result=%d\n", ret);
+
+	return ret;
 }
 
 static int pwrseq_qcom_wcn_vregs_disable(struct pwrseq_device *pwrseq)
@@ -170,9 +178,13 @@ static int pwrseq_qcom_wcn_wlan_enable(struct pwrseq_device *pwrseq)
 {
 	struct pwrseq_qcom_wcn_ctx *ctx = pwrseq_device_get_drvdata(pwrseq);
 
+	pr_info("SM-X910 WCN diag: WLAN_EN before=%d\n",
+		gpiod_get_value_cansleep(ctx->wlan_gpio));
 	pwrseq_qcom_wcn_ensure_gpio_delay(ctx);
 	gpiod_set_value_cansleep(ctx->wlan_gpio, 1);
 	ctx->last_gpio_enable_jf = jiffies;
+	pr_info("SM-X910 WCN diag: WLAN_EN after=%d\n",
+		gpiod_get_value_cansleep(ctx->wlan_gpio));
 
 	return 0;
 }
@@ -477,6 +489,8 @@ static int pwrseq_qcom_wcn_probe(struct platform_device *pdev)
 	if (ret < 0)
 		return dev_err_probe(dev, ret,
 				     "Failed to get all regulators\n");
+	dev_info(dev, "SM-X910 WCN diag: acquired %zu PMU input regulators\n",
+		 ctx->pdata->num_vregs);
 
 	if (ctx->pdata->has_vddio) {
 		ctx->vddio = devm_regulator_get(dev, "vddio");
@@ -512,8 +526,11 @@ static int pwrseq_qcom_wcn_probe(struct platform_device *pdev)
 	 * Set direction to output but keep the current value in order to not
 	 * disable the WLAN module accidentally if it's already powered on.
 	 */
-	gpiod_direction_output(ctx->wlan_gpio,
-			       gpiod_get_value_cansleep(ctx->wlan_gpio));
+	ret = gpiod_get_value_cansleep(ctx->wlan_gpio);
+	dev_info(dev, "SM-X910 WCN diag: WLAN_EN initial=%d\n", ret);
+	ret = gpiod_direction_output(ctx->wlan_gpio, ret > 0);
+	dev_info(dev, "SM-X910 WCN diag: WLAN_EN direction result=%d value=%d\n",
+		 ret, gpiod_get_value_cansleep(ctx->wlan_gpio));
 
 	ctx->clk = devm_clk_get_optional(dev, NULL);
 	if (IS_ERR(ctx->clk))
@@ -533,6 +551,8 @@ static int pwrseq_qcom_wcn_probe(struct platform_device *pdev)
 	if (IS_ERR(ctx->pwrseq))
 		return dev_err_probe(dev, PTR_ERR(ctx->pwrseq),
 				     "Failed to register the power sequencer\n");
+
+	dev_info(dev, "SM-X910 WCN diag: power sequencer registered\n");
 
 	return 0;
 }
